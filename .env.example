CHAT_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
EXAM_MOCK_LLM_ENABLED=0
EXAM_MOCK_OLLAMA_MODELS=llama3.2:1b,llama3.2:3b
EXAM_MOCK_OLLAMA_TIMEOUT=12
OLLAMA_ENABLE_STARTUP_WARMUP=0
OLLAMA_STARTUP_WARMUP_DELAY_SEC=8
OLLAMA_SPEED_PRESET=balanced
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_CHAT_TIMEOUT=35
TUTOR_STREAMING_ENABLED=1
# Local Tutor TTS:
# 1. Install inside the repo venv: .\.venv\Scripts\python.exe -m pip install piper-tts
# 2. Download these files into .\data\tts\voices\ :
#    - de_DE-thorsten-medium.onnx
#    - de_DE-thorsten-medium.onnx.json
TUTOR_TTS_PROVIDER=piper
TUTOR_TTS_FALLBACK=browser
TUTOR_TTS_VOICE=de_DE-thorsten-medium
TUTOR_TTS_MODEL_PATH=data/tts/voices/de_DE-thorsten-medium.onnx
TUTOR_TTS_CONFIG_PATH=data/tts/voices/de_DE-thorsten-medium.onnx.json
# Optional persona-specific local Tutor voices.
# If a persona bundle is missing or invalid, the Tutor falls back to the global
# TUTOR_TTS_* settings above.
TUTOR_TTS_STUDIO_VOICE=
TUTOR_TTS_STUDIO_MODEL_PATH=
TUTOR_TTS_STUDIO_CONFIG_PATH=
TUTOR_TTS_COACH_VOICE=
TUTOR_TTS_COACH_MODEL_PATH=
TUTOR_TTS_COACH_CONFIG_PATH=
TUTOR_TTS_EXAMINER_VOICE=
TUTOR_TTS_EXAMINER_MODEL_PATH=
TUTOR_TTS_EXAMINER_CONFIG_PATH=
TUTOR_TTS_MAX_CHARS=280
TRANSCRIBE_PROVIDER=local
MOCK_AUDIO_PROVIDER=none
MOCK_AUDIO_EAGER=0
MOCK_AUDIO_VOICE_HINT=
MOCK_AUDIO_VOICE_GENDER=auto
LOCAL_TRANSCRIBE_MODEL=base
LOCAL_TRANSCRIBE_DEVICE=cpu
LOCAL_TRANSCRIBE_COMPUTE_TYPE=int8
LOCAL_TRANSCRIBE_BEAM_SIZE=1
LOCAL_TRANSCRIBE_VAD_FILTER=1

ALLOWED_ORIGINS=*
APP_TIMEZONE=Europe/Madrid
APP_DATA_DIR=./data
APP_DB_PATH=./data/learning_app.db
APP_EXPLANATION_LANGUAGE=es
APP_DEFAULT_GOAL_EXAM=goethe_b2
APP_UI_LANGUAGE=de

# Canonical experiment labels. Keep these stable once thesis data collection starts.
# Recommendation: adaptive_heuristic_v1 | fixed_path_v1
# Review scheduling: sm2_v1 | fixed_interval_v1
# Assessment: standard_v1 | enriched_v1
APP_RECOMMENDATION_STRATEGY=adaptive_heuristic_v1
APP_REVIEW_STRATEGY=sm2_v1
APP_ASSESSMENT_MODE=standard_v1
